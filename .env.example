# Copy to `.env` (same directory) and fill in values. The hook reads .env from
# the TARGET repository root at commit time, so replicate this file there.
#
# LLM configuration is completely MODEL-AGNOSTIC.
# Simply provide any API key and model name, and it will run automatically!
#
# QUICK START — EITHER generic variables:
#   MODEL=gpt-4o
#   API_KEY=sk-...
#
# OR provider-specific variables (auto-detected):
#   OPENAI_API_KEY=sk-...
#   GEMINI_API_KEY=AIzaSy...
#   ANTHROPIC_API_KEY=sk-ant-...
#   DEEPSEEK_API_KEY=sk-...
#   GROQ_API_KEY=gsk_...
#
# ---------------------------------------------------------------------------
# LLM CORE (all optional; provider & endpoints are auto-detected)
# ---------------------------------------------------------------------------

# Provider preset (optional, auto-inferred from model or key shape):
# nous | groq | openai | gemini | anthropic | deepseek | mistral | openrouter | together | perplexity | xai | cohere | cerebras | sambanova | ollama | custom
UNDERSTANDING_AGENT_PROVIDER=

# Model id (e.g. gpt-4o, gemini-2.0-flash, claude-3-5-sonnet-20241022, deepseek-chat, llama-3.3-70b-versatile)
UNDERSTANDING_AGENT_MODEL=

# Endpoint override (makes ANY OpenAI-compatible provider work, e.g. vLLM, LM Studio, Ollama, private gateway)
UNDERSTANDING_AGENT_BASE_URL=

# Central API key (or use MODEL/API_KEY, or provider-specific vars like GEMINI_API_KEY, OPENAI_API_KEY, etc.)
UNDERSTANDING_AGENT_API_KEY=

# Model used to EVALUATE answers (the judge). Deliberately separable from the
# question-GENERATION model to avoid self-preference bias. Empty = same model.
UNDERSTANDING_AGENT_JUDGE_MODEL=

# Provider-specific examples:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# NOUS_API_KEY=

# BEHAVIOR FLAGS (all optional; defaults shown)

# Suppress model thinking/reasoning tokens (bench: 51s -> 10s per call).
# Set to `off` to re-enable thinking. Default: on (suppressed).
# UNDERSTANDING_AGENT_DISABLE_THINKING=on

# Credential gate (deterministic, LLM-free). `off` disables. Default: on.
# UNDERSTANDING_AGENT_SECURITY_GATE=on

# Master Analysis Pass: one LLM call producing change classification,
# advisory findings, and checklist-bearing questions. Default: off (legacy path).
# UNDERSTANDING_AGENT_MASTER_ANALYSIS=1

# Fail mode when the LLM is unreachable: open (allow commit, mark unverified)
# or closed (block). Default: open.
# UNDERSTANDING_AGENT_FAIL_MODE=open

# INFRA (optional)

# Max sessions kept in the local SQLite store (.git/understanding_sessions.db;
# 0600 perms; legacy JSON is imported once on first open). Default 500.
# UNDERSTANDING_AGENT_MAX_SESSIONS=500

# Telemetry endpoint (POST session payloads). Empty = telemetry off.
# UNDERSTANDING_AGENT_TELEMETRY_URL=

# CENTRAL LEDGER SYNC (Pokerface P3 / Judas) — set to the central service
# BASE url to enable queue-backed sync (offline sessions are queued in
# .git/understanding_sync_queue.json and drained on the next run).
# Empty = sync off. Mutually independent from the legacy telemetry URL.
# UNDERSTANDING_AGENT_SYNC_URL=http://understanding.internal:8000

# Shared team token (X-Team-Token header) — authorizes writes to the ledger.
# UNDERSTANDING_AGENT_TEAM_KEY=

# HMAC-SHA256 secret (X-Signature header over the canonical payload).
# Raises the anti-spoofing floor; proves the team, not the individual.
# UNDERSTANDING_AGENT_TEAM_SECRET=

# ACTOR MODE (Judas J2)

# `agent` = record-only mode: skip the oral defense, record the session as
# agent-unverified, exit 0. The credential gate still hard-blocks. A
# non-interactive environment (no TTY and no /dev/tty) auto-triggers the
# same record-and-pass path with verification=unattended-unverified.
# UNDERSTANDING_AGENT_MODE=

# VOICE / ANSWER HYGIENE (Pokerface P1)

# `off` disables the answer-hygiene re-ask for suspect captures (clipped mic,
# ASR stutter, empty submit). Default: on.
# UNDERSTANDING_AGENT_ANSWER_HYGIENE=on
