# Copy to `.env` (same directory) and fill in values. The hook reads .env from
# the TARGET repository root at commit time, so replicate this file there.
#
# Everything is resolved centrally in understanding_agent/llm_manager.py.
# Changing provider is ONE variable (UNDERSTANDING_AGENT_PROVIDER).

# LLM CORE (pick ONE provider block; the central vars win over legacy ones)

# Provider preset: nous | groq | openai | openrouter | together | ollama | custom
UNDERSTANDING_AGENT_PROVIDER=nous

# Model id (defaults come from the provider preset)
UNDERSTANDING_AGENT_MODEL=

# OpenAI-compatible endpoint override (makes ANY provider work)
UNDERSTANDING_AGENT_BASE_URL=

# Key for the active provider (else the preset's default: NOUS_API_KEY, etc.)
UNDERSTANDING_AGENT_API_KEY=

# Model used to EVALUATE answers (the judge). Deliberately separable from the
# question-GENERATION model to avoid self-preference bias. Empty = same model.
UNDERSTANDING_AGENT_JUDGE_MODEL=

# Legacy provider keys (still honored; UNDERSTANDING_AGENT_API_KEY wins)
NOUS_API_KEY=
# NOUS_MODEL=
# NOUS_BASE_URL=
# GROQ_API_KEY=
# GROQ_MODEL=
# GROQ_BASE_URL=

# BEHAVIOR FLAGS (all optional; defaults shown)

# Suppress model thinking/reasoning tokens (bench: 51s -> 10s per call).
# Set to `off` to re-enable thinking. Default: on (suppressed).
# UNDERSTANDING_AGENT_DISABLE_THINKING=on

# Credential gate (deterministic, LLM-free). `off` disables. Default: on.
# UNDERSTANDING_AGENT_SECURITY_GATE=on

# Master Analysis Pass: one LLM call producing change classification,
# advisory findings, and checklist-bearing questions. Default: off (legacy path).
# UNDERSTANDING_AGENT_MASTER_ANALYSIS=1

# Fail mode when the LLM is unreachable: open (allow commit, mark unverified)
# or closed (block). Default: open.
# UNDERSTANDING_AGENT_FAIL_MODE=open

# INFRA (optional)

# Max sessions kept in .git/understanding_sessions.json (pruning). Default 500.
# UNDERSTANDING_AGENT_MAX_SESSIONS=500

# Telemetry endpoint (POST session payloads). Empty = telemetry off.
# UNDERSTANDING_AGENT_TELEMETRY_URL=
