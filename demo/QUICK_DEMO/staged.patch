+"""Payment gateway integration for checkout."""
+
+STRIPE_SECRET_KEY = "sk_live_9fK2mQ7xR4wZ8vN3pL6dY1sT5bH"
+
+GATEWAY_URL = "https://api.stripe.com/v1/charges"
+
+
+def create_charge(amount):
+    """Charge the given amount via the configured gateway."""
+    import urllib.request
+
+    req = urllib.request.Request(
+        GATEWAY_URL,
+        data=f"amount={amount}".encode(),
+        headers={"Authorization": f"Bearer {STRIPE_SECRET_KEY}"},
+    )
+    return urllib.request.urlopen(req).read()
