\ No newline at end of file
+    return total - total * (pct / 100.0)
+
+
+def stack_coupons(total, coupons):
+    """Apply a list of percentage coupons in sequence.
+
+    Business rule: at most MAX_COUPONS coupons stack per order, and the
+    final total may never end up below the MIN_TOTAL floor.
+    """
+    if len(coupons) > MAX_COUPONS:
+        raise ValueError(f"at most {MAX_COUPONS} coupons per order")
+    for pct in coupons:
+        total = apply_discount(total, pct)
+        if total < MIN_TOTAL:
+            break
+    return round(total, 2)
